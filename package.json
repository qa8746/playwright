{
  "name": "playwright-typescript-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests written with TypeScript and Cucumber BDD",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:debug": "cross-env HEADLESS=false DEBUG=pw:api cucumber-js",
    "test:report": "cucumber-js --format progress --format html:reports/cucumber-report.html"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/node": "^22.15.3",
    "cross-env": "^7.0.3",
    "playwright": "^1.63.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
